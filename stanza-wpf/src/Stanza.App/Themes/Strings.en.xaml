<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Sidebar -->
    <sys:String x:Key="Sidebar_Projects">Projects</sys:String>
    <sys:String x:Key="Sidebar_Tags">Tags</sys:String>
    <sys:String x:Key="Tip_ToggleSection">Collapse / expand</sys:String>

    <!-- Tool buttons -->
    <sys:String x:Key="Gesture_Suffix"> ({0})</sys:String>
    <sys:String x:Key="Tip_OpenFile">Open file</sys:String>
    <sys:String x:Key="Tip_NewFile">New file</sys:String>
    <sys:String x:Key="Tip_RecentFiles">Recent files</sys:String>
    <sys:String x:Key="Tip_Settings">Settings</sys:String>
    <sys:String x:Key="Tip_RemoveRecent">Remove from list</sys:String>
    <sys:String x:Key="Recent_Empty">No recent files</sys:String>
    <sys:String x:Key="Tip_Minimize">Minimize</sys:String>
    <sys:String x:Key="Tip_Maximize">Maximize / restore</sys:String>
    <sys:String x:Key="Tip_CloseWindow">Close</sys:String>

    <!-- Task toolbar -->
    <sys:String x:Key="Tip_AddTask">Add task</sys:String>
    <sys:String x:Key="Tip_Clear">Clear</sys:String>
    <sys:String x:Key="Tip_ClearConfirm">Click again to confirm</sys:String>
    <sys:String x:Key="Tip_Complete">Complete</sys:String>
    <sys:String x:Key="Tip_Defer">Move to WAIT</sys:String>
    <sys:String x:Key="Tip_Activate">Move to DOING</sys:String>
    <sys:String x:Key="Tip_Restore">Restore</sys:String>
    <sys:String x:Key="Tip_Discard">Discard (Backspace)</sys:String>
    <sys:String x:Key="Tip_Delete">Delete permanently (Delete)</sys:String>
    <sys:String x:Key="Tip_HasNotes">Has notes</sys:String>

    <!-- Empty state / welcome / drop ({0} = shortcut, filled in code) -->
    <sys:String x:Key="Empty_NoTasks">No tasks yet&#x0a;Press {0} or click below to add one</sys:String>
    <sys:String x:Key="Welcome_Tagline">Minimal plain-text task management</sys:String>
    <sys:String x:Key="Welcome_OpenHint">Drag a .stanza file into the window, or press {0}</sys:String>
    <sys:String x:Key="Welcome_NewHint">{0} for a new file</sys:String>
    <sys:String x:Key="Drop_Hint">Release to open file</sys:String>

    <!-- Exit overlay -->
    <sys:String x:Key="Exit_Title">Unsaved changes</sys:String>
    <sys:String x:Key="Exit_Hint">If you quit now, changes to "{0}" will be lost.</sys:String>
    <sys:String x:Key="Exit_Cancel">Cancel</sys:String>
    <sys:String x:Key="Exit_Discard">Don't Save</sys:String>
    <sys:String x:Key="Exit_Save">Save</sys:String>

    <!-- Tag/project picker -->
    <sys:String x:Key="Picker_Clear">Clear</sys:String>
    <sys:String x:Key="Picker_Tag">Tag</sys:String>
    <sys:String x:Key="Picker_Project">Project</sys:String>
    <sys:String x:Key="Picker_ErrorTag">Must start with a letter; letters, digits, _ and - allowed</sys:String>
    <sys:String x:Key="Picker_ErrorProject">Must start with a letter or digit; letters, digits, _ and - allowed</sys:String>

    <!-- File dialogs -->
    <sys:String x:Key="Dialog_OpenTitle">Open Stanza File</sys:String>
    <sys:String x:Key="Dialog_SaveTitle">Save Stanza File</sys:String>
    <sys:String x:Key="Dialog_OpenFilter">Stanza files (*.stanza;*.txt)|*.stanza;*.txt|All files (*.*)|*.*</sys:String>
    <sys:String x:Key="Dialog_SaveFilter">Stanza files (*.stanza)|*.stanza|Text files (*.txt)|*.txt</sys:String>

    <!-- Preset tags (comma-separated; Things 3 inspired, picker candidates only) -->
    <sys:String x:Key="Preset_Tags">Errands,Home,Office,Important,Pending</sys:String>

    <!-- State block display names (English keeps the RFC tokens) -->
    <sys:String x:Key="State_DOING">DOING</sys:String>
    <sys:String x:Key="State_WAIT">WAIT</sys:String>
    <sys:String x:Key="State_DONE">DONE</sys:String>
    <sys:String x:Key="State_DELETE">DELETE</sys:String>

    <!-- Task context menu -->
    <sys:String x:Key="Menu_Complete">Complete</sys:String>
    <sys:String x:Key="Menu_Defer">Move to WAIT</sys:String>
    <sys:String x:Key="Menu_Activate">Move to DOING</sys:String>
    <sys:String x:Key="Menu_Priority">Priority</sys:String>
    <sys:String x:Key="Menu_Tags">Tags…</sys:String>
    <sys:String x:Key="Menu_Project">Project…</sys:String>
    <sys:String x:Key="Menu_Discard">Discard</sys:String>
    <sys:String x:Key="Menu_Restore">Restore</sys:String>
    <sys:String x:Key="Menu_Delete">Delete permanently</sys:String>

    <!-- Editor watermarks -->
    <sys:String x:Key="Watermark_TaskDraft">2026-08-07 Task description +project #tag</sys:String>
    <sys:String x:Key="Watermark_Notes">Notes</sys:String>

    <!-- Status bar -->
    <sys:String x:Key="Status_Missing">File no longer exists; removed from list</sys:String>
    <sys:String x:Key="Status_Warnings">Ignored {0} invalid line(s)</sys:String>
    <sys:String x:Key="Status_OpenFailed">Open failed: {0}</sys:String>
    <sys:String x:Key="Status_Saving">Saving…</sys:String>
    <sys:String x:Key="Status_Saved">Saved {0}</sys:String>
    <sys:String x:Key="Status_SaveFailed">Save failed: {0}</sys:String>
    <sys:String x:Key="Status_Dirty">Unsaved changes</sys:String>
    <sys:String x:Key="File_Untitled">Untitled.stanza</sys:String>

    <!-- Priority menu -->
    <sys:String x:Key="Priority_A">A  Important and urgent</sys:String>
    <sys:String x:Key="Priority_B">B  Important, not urgent</sys:String>
    <sys:String x:Key="Priority_C">C  Urgent, not important</sys:String>
    <sys:String x:Key="Priority_D">D  Not important, not urgent</sys:String>
    <sys:String x:Key="Priority_Clear">Clear priority</sys:String>

    <!-- Settings panel -->
    <sys:String x:Key="Settings_Title">Settings</sys:String>
    <sys:String x:Key="Settings_Language">Language</sys:String>
    <sys:String x:Key="Settings_Shortcuts">Shortcuts</sys:String>
    <sys:String x:Key="Settings_Recording">Press shortcut…</sys:String>
    <sys:String x:Key="Settings_NeedModifier">Needs a modifier (Ctrl/Shift/Alt) or a function key</sys:String>
    <sys:String x:Key="Settings_Conflict">{0} is already assigned to "{1}"</sys:String>
    <sys:String x:Key="Settings_Reassign">Reassign</sys:String>
    <sys:String x:Key="Settings_Reset">Reset</sys:String>
    <sys:String x:Key="Settings_NoneGesture">None</sys:String>
    <sys:String x:Key="Settings_GroupApp">App</sys:String>
    <sys:String x:Key="Settings_GroupTask">Task</sys:String>

    <!-- Command names -->
    <sys:String x:Key="Cmd_Save">Save</sys:String>
    <sys:String x:Key="Cmd_Open">Open File</sys:String>
    <sys:String x:Key="Cmd_NewTask">New Task</sys:String>
    <sys:String x:Key="Cmd_NewDocument">New File</sys:String>
    <sys:String x:Key="Cmd_OpenRecent">Open Recent</sys:String>
    <sys:String x:Key="Cmd_Undo">Undo</sys:String>
    <sys:String x:Key="Cmd_CompleteTask">Complete Task</sys:String>
    <sys:String x:Key="Cmd_OpenTagPicker">Open Tag Picker</sys:String>
    <sys:String x:Key="Cmd_OpenProjectPicker">Open Project Picker</sys:String>
    <sys:String x:Key="Cmd_DiscardTask">Move to Trash</sys:String>
    <sys:String x:Key="Cmd_DeleteTask">Delete Permanently</sys:String>
    <sys:String x:Key="Cmd_NavigateUp">Select Previous</sys:String>
    <sys:String x:Key="Cmd_NavigateDown">Select Next</sys:String>
    <sys:String x:Key="Cmd_NavigateLeft">Move Focus Left</sys:String>
    <sys:String x:Key="Cmd_NavigateRight">Move Focus Right</sys:String>
    <sys:String x:Key="Cmd_SelectBlock">Switch to {0}</sys:String>

</ResourceDictionary>
