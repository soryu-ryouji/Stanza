<ResourceDictionary x:Class="Stanza.App.Themes.TaskTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Stanza.App.ViewModels"
                    xmlns:app="clr-namespace:Stanza.App"
                    xmlns:behaviors="clr-namespace:Stanza.App.Behaviors">

    <!-- 任务标题配色：象限 → 文字颜色（A 红 → B 蓝 → C 琥珀 → D 淡灰），映射的唯一来源是
         QuadrantToBrushConverter；无优先级或非活跃状态为默认墨色。优先级强度由整行文字承担，
         不使用徽章元素；同象限内的先后由排序位置表达，不做颜色编码 -->
    <Style x:Key="TaskTitleText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{Binding DisplayQuadrant, Converter={StaticResource QuadrantToBrush}}"/>
    </Style>

    <!-- 展开态标题编辑框：与折叠态同一套象限配色，输入时颜色实时跟随解析结果 -->
    <Style x:Key="TaskTitleEditor" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Foreground" Value="{Binding DisplayQuadrant, Converter={StaticResource QuadrantToBrush}}"/>
    </Style>

    <!-- 任务卡片 -->
    <DataTemplate x:Key="TaskTemplate" DataType="{x:Type vm:TaskViewModel}">
        <!-- 普通态透明：任务行直接躺在灰色画布上，只有悬停/选中/展开才出现色面 -->
        <!-- Tag 桥接主窗口 DataContext（此绑定在正常视觉树中，可找到 Window）；
             ContextMenu 在独立弹层树中，MenuItem 经 PlacementTarget.Tag 取到命令 -->
        <Border x:Name="Card" Background="Transparent" CornerRadius="8" Margin="8,6"
                BorderBrush="Transparent" BorderThickness="1"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
            <Border.ContextMenu>
                <!-- Tag 桥接命令 ID：Opened 时从键位表取当前手势填入 InputGestureText（Templates.xaml.cs） -->
                <ContextMenu Opened="FacetContextMenu_Opened">
                    <MenuItem Icon="&#xE73E;" Header="{DynamicResource Menu_Complete}" Tag="CompleteTask" Command="{Binding PlacementTarget.Tag.CompleteSelectionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                              Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                    </MenuItem>
                    <MenuItem Icon="&#xE769;" Header="{DynamicResource Menu_Defer}" Command="{Binding PlacementTarget.Tag.DeferSelectionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                              Visibility="{Binding IsDoing, Converter={StaticResource BoolToVis}}">
                    </MenuItem>
                    <MenuItem Icon="&#xE768;" Header="{DynamicResource Menu_Activate}" Command="{Binding PlacementTarget.Tag.ActivateSelectionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                              Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVis}}">
                    </MenuItem>
                    <MenuItem Icon="&#xE7C1;" Header="{DynamicResource Menu_Priority}" ItemContainerStyle="{StaticResource PriorityMenuItem}"
                              ItemsSource="{Binding PlacementTarget.Tag.PriorityOptions, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                              Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                    </MenuItem>
                    <MenuItem Icon="&#xE8EC;" Header="{DynamicResource Menu_Tags}" Tag="OpenTagPicker" Click="FacetMenu_TagClick">
                    </MenuItem>
                    <MenuItem Icon="&#xE8B7;" Header="{DynamicResource Menu_Project}" Tag="OpenProjectPicker" Click="FacetMenu_ProjectClick">
                    </MenuItem>
                    <MenuItem Icon="&#xE74D;" Header="{DynamicResource Menu_Discard}" Tag="DiscardTask" Command="{Binding PlacementTarget.Tag.DiscardSelectionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                              Visibility="{Binding IsDeleted, Converter={StaticResource InverseBoolToVis}}">
                    </MenuItem>
                    <MenuItem Icon="&#xE7A7;" Header="{DynamicResource Menu_Restore}" Command="{Binding PlacementTarget.Tag.RestoreSelectionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                              Visibility="{Binding CanRestore, Converter={StaticResource BoolToVis}}">
                    </MenuItem>
                    <Separator Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Icon="&#xE711;" Header="{DynamicResource Menu_Delete}" Tag="DeleteTask" Style="{StaticResource DangerMenuItem}"
                              Command="{Binding PlacementTarget.Tag.DeleteSelectionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                              Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}}">
                    </MenuItem>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <Grid x:Name="CardContent" Margin="12,9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 折叠态：标题行 -->
                    <StackPanel x:Name="ReadHeader" Grid.Row="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Style="{StaticResource TaskCheckBox}" Margin="0,0,10,0"
                                      Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                      Click="TaskCheck_Click"/>

                            <TextBlock Grid.Column="1" Text="{Binding DueDisplay}" FontSize="12"
                                       Foreground="{StaticResource FaintBrush}" Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasDue, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Column="2" Style="{StaticResource TaskTitleText}" Text="{Binding Description}"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 完成日期（仅 DONE 任务）：归档列表中最有用的生命周期信息 -->
                                <TextBlock Text="{Binding CompletedDisplay}" FontSize="12"
                                           Foreground="{StaticResource FaintBrush}" Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding ShowCompleted, Converter={StaticResource BoolToVis}}"/>
                                <!-- 标签在前：变动频繁且数量/长度不固定；项目在后：归属稳定 -->
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="9"
                                                    Padding="7,1" Margin="4,0,0,0">
                                                <TextBlock Text="{Binding ., StringFormat=#{0}}" FontSize="11"
                                                           Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Background="{StaticResource ChipBrush}" CornerRadius="9"
                                        Padding="7,1" Margin="6,0,0,0"
                                        Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ProjectDisplay}" FontSize="11"
                                               Foreground="{StaticResource GrayBrush}"/>
                                </Border>
                                <!-- 备注标记固定在行尾最右缘（Things 风格：只提示存在，不渲染内容），
                                     尺寸恒定不受 chip 增减影响，位置稳定便于扫读 -->
                                <Path Data="M0,0.5 H10 M0,3.5 H10 M0,6.5 H6" Stroke="{StaticResource FaintBrush}"
                                      StrokeThickness="1.2" Width="10" Height="7" Margin="6,0,0,0"
                                      VerticalAlignment="Center" ToolTip="{DynamicResource Tip_HasNotes}"
                                      Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 展开态标题行：勾选框 + 主行编辑框 + 项目/标签 chip + 备注图标 -->
                    <Grid x:Name="EditHeader" Grid.Row="0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 勾选框顶对齐：与标题首行文字对齐（多行标题时停在首行），
                             避免行高变化时居中重定位造成的位移 -->
                        <CheckBox Grid.Column="0" Style="{StaticResource TaskCheckBox}" Margin="0,0,10,0"
                                  VerticalAlignment="Top"
                                  Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                  Click="TaskCheck_Click"/>
                        <!-- MinHeight 与折叠态行高一致，展开/收起交换时行高不跳动 -->
                        <TextBox Grid.Column="1" Style="{StaticResource TaskTitleEditor}"
                                 Text="{Binding HeaderText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{DynamicResource Watermark_TaskDraft}" FontSize="14" MinHeight="20" TextWrapping="Wrap"
                                 PreviewKeyDown="TaskTitleEditor_PreviewKeyDown"/>
                        <!-- 项目/标签 chip：与折叠态一样钉在标题行右侧，展开时不移入详情面板；
                             顺序同折叠态：标签在前（变动频繁），项目在后（归属稳定） -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="9"
                                                Padding="7,1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding ., StringFormat=#{0}}" FontSize="11"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="{StaticResource ChipBrush}" CornerRadius="9"
                                    Padding="7,1" Margin="6,0,0,0"
                                    Visibility="{Binding HasProject, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ProjectDisplay}" FontSize="11"
                                           Foreground="{StaticResource GrayBrush}"/>
                            </Border>
                        </StackPanel>
                        <!-- 备注图标钉在标题行右缘（与折叠态位置一致），展开/收起时不出现、不移动 -->
                        <Path Grid.Column="3" Data="M0,0.5 H10 M0,3.5 H10 M0,6.5 H6" Stroke="{StaticResource FaintBrush}"
                              StrokeThickness="1.2" Width="10" Height="7" Margin="6,7,0,0"
                              VerticalAlignment="Top" ToolTip="{DynamicResource Tip_HasNotes}"
                              Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- 详情面板：展开/收起动画；左缩进与标题文本对齐（勾选框 17 + 间距 10） -->
                    <StackPanel x:Name="DetailsPanel" Grid.Row="1" Visibility="Collapsed"
                                Margin="27,0,0,0" ClipToBounds="True"
                                behaviors:RevealBehavior.IsRevealed="{Binding IsExpanded}"
                                behaviors:RevealBehavior.SpacingTarget="{Binding ElementName=Card}"
                                behaviors:RevealBehavior.ContentTarget="{Binding ElementName=CardContent}">
                        <!-- 解析出的元数据：仅填写过的才显示（优先级以标题文字颜色表达；
                             项目/标签固定在标题行右侧 chip，不在此行） -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding HasAnyMeta, Converter={StaticResource BoolToVis}}">
                            <Border Background="{StaticResource ChipBrush}" CornerRadius="9"
                                    Padding="7,1"
                                    Visibility="{Binding HasDue, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding DueDisplay}" FontSize="11"
                                           Foreground="{StaticResource GrayBrush}"/>
                            </Border>
                            <!-- 创建/完成时间：续行属性（§7.4），与截止日期同款 chip，带关键字前缀区分 -->
                            <Border Background="{StaticResource ChipBrush}" CornerRadius="9"
                                    Padding="7,1" Margin="6,0,0,0"
                                    Visibility="{Binding HasCreated, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding CreatedDisplay}" FontSize="11"
                                           Foreground="{StaticResource GrayBrush}"/>
                            </Border>
                            <Border Background="{StaticResource ChipBrush}" CornerRadius="9"
                                    Padding="7,1" Margin="6,0,0,0"
                                    Visibility="{Binding HasCompleted, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding CompletedDisplay}" FontSize="11"
                                           Foreground="{StaticResource GrayBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- 备注：透明融进详情卡，与卡片同一色面，空内容时水印提示。
                             Enter 提交任务、Shift+Enter 换行（HandleTaskNotesKey） -->
                        <TextBox Text="{Binding NotesText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{DynamicResource Watermark_Notes}" Margin="0,6,0,0" FontSize="14"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="40" VerticalContentAlignment="Top"
                                 PreviewKeyDown="TaskNotesEditor_PreviewKeyDown"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <!-- 视觉优先级：悬停 < 选中 < 展开 -->
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHoverBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource TaskSelectedBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                <Setter TargetName="ReadHeader" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="EditHeader" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <!-- 展开卡外观由 RevealBehavior.IsChromeActive 驱动：收起动画播完才卸下，折叠过程全程可见 -->
            <DataTrigger Binding="{Binding (behaviors:RevealBehavior.IsChromeActive), ElementName=Card}" Value="True">
                <Setter TargetName="Card" Property="Background" Value="White"/>
                <Setter TargetName="Card" Property="BorderBrush" Value="#FFE5E5EA"/>
                <!-- 展开卡抬高一层：柔和投影把视觉重心拉到当前任务 -->
                <Setter TargetName="Card" Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.10" Color="#FF1C1C1E"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 拖拽位置预览占位 -->
    <DataTemplate x:Key="GapTemplate" DataType="{x:Type vm:GapItem}">
        <Border Height="{Binding Height}" Margin="8,6" CornerRadius="8"
                Background="{StaticResource AccentSoftBrush}" Opacity="0.65"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"/>
    </DataTemplate>

    <!-- 拖拽幽灵卡片 -->
    <DataTemplate x:Key="TaskGhostTemplate" DataType="{x:Type vm:TaskViewModel}">
        <StackPanel Orientation="Horizontal">
            <Border Width="17" Height="17" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center"
                    BorderBrush="#FFC7C7CC" BorderThickness="1.2"/>
            <TextBlock Style="{StaticResource TaskTitleText}" Text="{Binding Description}"
                       TextWrapping="NoWrap" MaxWidth="520" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </DataTemplate>

    <app:TaskListTemplateSelector x:Key="TaskListTemplateSelector"
                                  TaskTemplate="{StaticResource TaskTemplate}"
                                  GapTemplate="{StaticResource GapTemplate}"/>
</ResourceDictionary>
