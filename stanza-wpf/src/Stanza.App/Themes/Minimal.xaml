<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:Stanza.App"
                    xmlns:behaviors="clr-namespace:Stanza.App.Behaviors">

    <!-- ============ 调色板（参考 Things 3：白底 + 灰侧栏 + Things 蓝，灰色取 Apple 标签灰） ============ -->
    <SolidColorBrush x:Key="InkBrush" Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="GrayBrush" Color="#FF6E6E73"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#FF8E8E93"/>
    <SolidColorBrush x:Key="LineBrush" Color="#FFE9E9EC"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#FFE9E9ED"/>
    <!-- 画布底色：窗口与内容区的浅灰，白卡浮在其上形成层级 -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFEFEFF1"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FFFAFAFB"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF2E7DE9"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF1D6FD8"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFEAF3FD"/>
    <!-- 任务卡片选中底色：比 AccentSoft 深两档，选中态在灰画布上清晰可辨 -->
    <SolidColorBrush x:Key="TaskSelectedBrush" Color="#FFCFE3FC"/>
    <!-- 文本选中底色：浅蓝，比 AccentSoft 深，选中区域清晰可辨且保持柔和 -->
    <SolidColorBrush x:Key="AccentSelectBrush" Color="#FFBFDDF9"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#FFF0F0F3"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFDC2626"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFFEF2F2"/>
    <!-- 深色浮层面板（标签/项目选择器）：参考 Things 3 选择器，降低纯白面板在浅灰画布上的刺眼感 -->
    <SolidColorBrush x:Key="DarkPanelBrush" Color="#FF2C2C30"/>
    <SolidColorBrush x:Key="DarkPanelRaisedBrush" Color="#FF3A3A40"/>
    <SolidColorBrush x:Key="DarkPanelBorderBrush" Color="#FF45454B"/>
    <SolidColorBrush x:Key="OnDarkTextBrush" Color="#FFF5F5F7"/>


    <app:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    <app:ZeroToVisibilityConverter x:Key="ZeroToVis"/>
    <app:StateToBrushConverter x:Key="StateToBrush"/>
    <app:StateToNameConverter x:Key="StateToName"/>
    <app:StatusKindToBrushConverter x:Key="StatusToBrush"/>
    <app:QuadrantToBrushConverter x:Key="QuadrantToBrush"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ============ 自定义控件样式的公共基座 ============ -->
    <!-- 统一关闭虚线焦点框：FocusVisualStyle 的默认值是系统点线样式（实测：自定义样式
         不会摆脱它，应用级覆盖 SystemParameters.FocusVisualStyleKey 资源也无效），
         因此所有可交互控件样式统一 BasedOn 此基座，不再逐个写 FocusVisualStyle="{x:Null}" -->
    <Style x:Key="StanzaControlBase" TargetType="{x:Type Control}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!-- 交互控件（按钮/列表条目）持焦点时禁用 IME：中文输入法不在非文本元素上吞字母键，
             裸 hjkl / 方向键导航才能到达；文本框在 TextBox 基础样式上显式恢复 IME -->
        <Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
    </Style>

    <!-- ============ 文本 ============ -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>

    <!-- ============ 文本框：下划线极简风 ============ -->
    <Style TargetType="{x:Type TextBox}">
        <!-- 交互控件基座（StanzaControlBase）默认禁用 IME（裸 hjkl / 方向键导航不被中文输入法吞键），
             文本框显式恢复以输入中文 -->
        <Setter Property="InputMethod.IsInputMethodEnabled" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        <!-- 自绘光标：系统光标固定 1px 且高度占满行高（顶部高出字形），改为 2px 圆角竖条对齐字形墨水区 -->
        <Setter Property="behaviors:CustomCaretBehavior.IsEnabled" Value="True"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentSelectBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="27"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <!-- 无边框：卡片本身提供边界。Border 承载背景与内边距，
                         默认透明；填写区可设 Background 成为可见的「纸面」 -->
                    <Border Background="{TemplateBinding Background}" CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <!-- TextBox 内部自带 2px 左内缩（离屏渲染实测），负边距补偿，
                                 使文本与 TextBlock 同原点，展开/收起切换时不漂移 -->
                            <ScrollViewer x:Name="PART_ContentHost" Margin="-2,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          VerticalScrollBarVisibility="Hidden"/>
                            <!-- 占位提示：借用 Tag 属性传文本，对齐方式跟随 TextAlignment/VerticalContentAlignment，
                                 与真实文本同位（占位符应显示在文本将出现的位置） -->
                            <TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}"
                                       TextAlignment="{TemplateBinding TextAlignment}"
                                       Foreground="{StaticResource FaintBrush}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 幽灵按钮（无边框，悬停浅底） ============ -->
    <Style x:Key="GhostButton" TargetType="{x:Type Button}" BasedOn="{StaticResource StanzaControlBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 深色浮层上的行按钮（标签/项目选择器）：白字，悬停强调蓝底（Things 3 选择器行） -->
    <Style x:Key="PickerRowButton" TargetType="{x:Type Button}" BasedOn="{StaticResource StanzaControlBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource OnDarkTextBrush}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <!-- 方向键移动焦点即高亮当前行（与悬停同视觉） -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 对话框主要操作按钮：实心强调色 -->
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource StanzaControlBase}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 对话框危险操作按钮：红色文字，悬停淡红底 -->
    <Style x:Key="DialogDangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource StanzaControlBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 窗口控制按钮 ============ -->
    <Style x:Key="WindowButton" TargetType="{x:Type Button}" BasedOn="{StaticResource StanzaControlBase}">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FFECECEF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}">
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#FFE81123"/>
                            <Setter TargetName="Content" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 工具栏图标按钮 ============ -->
    <Style x:Key="ToolIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource StanzaControlBase}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerToolIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource StanzaControlBase}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 任务勾选框 ============ -->
    <Style x:Key="TaskCheckBox" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource StanzaControlBase}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border x:Name="Box" Width="17" Height="17" CornerRadius="4"
                            BorderBrush="#FFC7C7CC" BorderThickness="1.2" Background="Transparent">
                        <Path x:Name="Check" Data="M3.5,9 L7,12.5 L13.5,5" Stroke="White" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="Collapsed"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 列表 ============ -->
    <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource StanzaControlBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource StanzaControlBase}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 侧栏条目 -->
    <Style x:Key="SidebarItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource StanzaControlBase}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="6,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="10,7">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource TaskSelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 右键菜单 ============ -->
    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource StanzaControlBase}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16" Color="#FF1C1C1E"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource StanzaControlBase}">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <!-- Things 风格：图标 + 文字，高亮为强调蓝底白字（图标描边随 Foreground 联动） -->
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="8,5"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 图标：Icon 只传几何数据字符串，由模板内 Path 用 TemplateBinding 渲染。
                                 不要把 Path 元素放进 Icon 再用 RelativeSource 绑前景色——游离属性值元素
                                 上的祖先绑定在真实宿主时序下会求值失败（图标隐形，实测 stroke=null） -->
                            <!-- 图标：字体字形（Segoe Fluent Icons，WinUI FontIcon 同款方案），
                                 颜色经 TemplateBinding 随 Foreground 联动，高亮自动反白；Icon 传字形码 -->
                            <TextBlock x:Name="IconGlyph" Text="{TemplateBinding Icon}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <!-- 显式 TextBlock 绑定菜单项前景色：隐式 TextBlock 样式的墨色会盖住
                                 继承值，否则高亮（蓝底）时文字不变白 -->
                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}" VerticalAlignment="Center">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                            <!-- 子菜单箭头：仅有子项时显示 -->
                            <Path x:Name="Arrow" Grid.Column="2" Data="M0,0 L3.5,3.5 L0,7" Width="5" Height="8"
                                  Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"/>
                            <!-- 子菜单弹层：缺它则带子项的菜单永远无法展开；外观与 ContextMenu 一致。
                                 HorizontalOffset 让子菜单贴靠一级菜单右缘并留出间隙（不重叠） -->
                            <Popup x:Name="SubMenuPopup" Grid.ColumnSpan="3" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right" HorizontalOffset="16" VerticalOffset="-5">
                                <Border Background="White" CornerRadius="8" Padding="4"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16" Color="#FF1C1C1E"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 高亮且有子项时立即展开子菜单：默认行为走系统 MenuShowDelay（~400ms），
                             鼠标连续下划时明显不跟手。父项在子菜单导航期间保持高亮，不会误关 -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsHighlighted" Value="True"/>
                                <Condition Property="HasItems" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="IsSubmenuOpen" Value="True"/>
                        </MultiTrigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <!-- 子菜单展开期间父项保持高亮（蓝底白字），标识当前所在的菜单路径 -->
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconGlyph" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerMenuItem" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource StanzaControlBase}">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="8,5"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IconGlyph" Text="{TemplateBinding Icon}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}" VerticalAlignment="Center">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconGlyph" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 优先级菜单项：Header/命令绑定到 PriorityOption，由 ItemsSource 生成
         （ItemContainerStyle 沿 MenuItem 子菜单继承，象限项自动获得同一样式）。
         命令经 PlacementTarget.Tag 桥接主窗口 DataContext（ContextMenu 在独立弹层视觉树中）。
         任务右键菜单与底部工具栏共用此样式 -->
    <Style x:Key="PriorityMenuItem" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Header" Value="{Binding Label}"/>
        <Setter Property="Command" Value="{Binding PlacementTarget.Tag.SetPriorityCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
        <Setter Property="CommandParameter" Value="{Binding .}"/>
    </Style>

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="6,3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 隐式 ScrollViewer：未使用自定义样式的 ScrollViewer（如侧栏项目/标签的滚动容器）
         带着系统默认的虚线焦点框（Alt 触发焦点提示时可见），统一继承基座关闭 -->
    <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource StanzaControlBase}"/>

    <!-- 细滚动条（由 TaskScrollViewer 模板内的 ScrollBar 显式引用） -->
    <Style x:Key="SlimScrollBar" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource StanzaControlBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Width="6">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbBg" Background="#FFD4D4D8"
                                                    CornerRadius="3" Margin="1,1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="NaN"/>
                            <Setter Property="Height" Value="6"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 任务列表用 ScrollViewer：滚动条列常驻（Auto 宽），不影响内容布局 -->
    <Style x:Key="TaskScrollViewer" TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource StanzaControlBase}">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                                   Style="{StaticResource SlimScrollBar}"
                                   Orientation="Vertical"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding Path=VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 任务列表：使用定制 ScrollViewer -->
    <!-- 任务列表：BasedOn 隐式 ListBox 样式以继承基座（StanzaControlBase）等基础设置 -->
    <Style x:Key="TaskListBox" TargetType="{x:Type ListBox}"
           BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <!-- Padding 传给 ScrollViewer 内部的内容区，滚动条列保留在列表右缘（贴近窗口边缘） -->
                    <ScrollViewer Style="{StaticResource TaskScrollViewer}" Focusable="False"
                                  Padding="{TemplateBinding Padding}">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 工具提示 ============ -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource GrayBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="8,4"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.12" Color="#FF1C1C1E"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
