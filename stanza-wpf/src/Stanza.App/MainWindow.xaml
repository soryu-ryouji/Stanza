<Window x:Class="Stanza.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Stanza.App.ViewModels"
        xmlns:app="clr-namespace:Stanza.App"
        xmlns:behaviors="clr-namespace:Stanza.App.Behaviors"
        Title="Stanza" Width="1020" Height="700" MinWidth="760" MinHeight="520"
        Icon="pack://application:,,,/Assets/icon.png"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        AllowDrop="True"
        DragEnter="Window_DragEnter" DragOver="Window_DragOver"
        DragLeave="Window_DragLeave" Drop="Window_Drop"
        Closing="Window_Closing">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewTaskCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl+Shift" Command="{Binding NewDocumentCommand}"/>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding SelectBlockCommand}" CommandParameter="1"/>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding SelectBlockCommand}" CommandParameter="2"/>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding SelectBlockCommand}" CommandParameter="3"/>
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding SelectBlockCommand}" CommandParameter="4"/>
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Templates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="ShadowHost" Margin="16">
        <!-- 静态阴影源：独立一层且不随内容变化，避免动画时每帧重算整窗模糊 -->
        <Border x:Name="ShadowShape" Background="#FF1C1C1E" CornerRadius="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.28"/>
            </Border.Effect>
        </Border>
        <Border x:Name="WindowFrame" Background="{StaticResource CanvasBrush}" SizeChanged="WindowFrame_SizeChanged">
    <Grid x:Name="Root">
        <!-- ============ 内容区（充满整个窗口，悬浮层位于其上） ============ -->
        <Grid x:Name="ContentArea" PreviewMouseLeftButtonDown="ContentArea_PreviewMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧栏 -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 侧栏顶部：文件名（兼窗口拖拽面） -->
                    <Border Grid.Row="0" Background="Transparent"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock Text="{Binding FileName}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource GrayBrush}" Margin="14,0,8,0"
                                   ToolTip="{Binding FilePath}" TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <ListBox x:Name="BlockList" Grid.Row="1"
                             ItemsSource="{Binding Blocks}"
                             SelectedItem="{Binding SelectedBlock, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource SidebarItemStyle}"
                             Margin="0,2,0,0" VerticalAlignment="Top">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}"/>
                                    <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}"
                                               Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TaskCount}" FontSize="11"
                                               Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                        <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- 左下角：打开文件 / 新建文件 / 最近文件 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,6">
                        <Button Style="{StaticResource ToolIconButton}" ToolTip="打开文件（Ctrl+O）"
                                Command="{Binding OpenCommand}">
                            <Path Data="M2.5,4 H6.5 L8.5,6.5 H13.5 V12.5 H2.5 Z" Width="16" Height="16"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                        <Button Style="{StaticResource ToolIconButton}" ToolTip="新建文件（Ctrl+Shift+N）"
                                Command="{Binding NewDocumentCommand}">
                            <Path Data="M4.5,2.5 H9.5 L11.5,4.5 V13.5 H4.5 Z M9.5,2.5 V4.5 H11.5 M8,7.5 V10.5 M6.5,9 H9.5"
                                  Width="16" Height="16"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                        <Button x:Name="RecentButton" Style="{StaticResource ToolIconButton}" ToolTip="最近打开的文件"
                                Click="RecentButton_Click">
                            <Path Data="M8,2.8 A5.2,5.2 0 1 0 8,13.2 A5.2,5.2 0 1 0 8,2.8 M8,5.2 V8 L10.2,9.2"
                                  Width="16" Height="16"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                  StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                    </StackPanel>
                    <Popup x:Name="RecentPopup" PlacementTarget="{Binding ElementName=RecentButton}"
                           Placement="Top" AllowsTransparency="True">
                        <Border x:Name="RecentPanel" Background="White" CornerRadius="8" Padding="4"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                Width="208" Margin="0,0,0,2">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18" Color="#FF1C1C1E"/>
                            </Border.Effect>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Recents.Items}">
                                    <!-- 条目容器拉伸到整行宽度，保证每行一致 -->
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="{x:Type ContentPresenter}">
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button x:Name="RowButton" Style="{StaticResource GhostButton}"
                                                    HorizontalContentAlignment="Stretch" Padding="8,5"
                                                    ToolTip="{Binding Path}"
                                                    Command="{Binding DataContext.Recents.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}"
                                                    CommandParameter="{Binding Path}"
                                                    Click="RecentItem_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="24"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Button x:Name="RemoveButton" Content="×" FontSize="11"
                                                            Grid.Column="1" VerticalAlignment="Center"
                                                            Style="{StaticResource GhostButton}" Padding="6,1"
                                                            ToolTip="从列表移除"
                                                            Command="{Binding DataContext.Recents.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}"
                                                            CommandParameter="{Binding Path}"
                                                            Opacity="0" IsHitTestVisible="False"/>
                                                </Grid>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=RowButton}" Value="True">
                                                    <Setter TargetName="RemoveButton" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="RemoveButton" Property="IsHitTestVisible" Value="True"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="暂无最近文件" FontSize="11" Padding="8,6"
                                           Foreground="{StaticResource FaintBrush}"
                                           Visibility="{Binding Recents.Items.Count, Converter={StaticResource ZeroToVis}}"/>
                                <!-- 固定在列表底部的新建入口，点击后关闭弹层 -->
                                <Separator/>
                                <Button Style="{StaticResource GhostButton}" Content="新建文件"
                                        HorizontalContentAlignment="Left" Padding="8,5"
                                        ToolTip="新建文件（Ctrl+Shift+N）"
                                        Command="{Binding NewDocumentCommand}"
                                        Click="RecentItem_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="{StaticResource LineBrush}"/>

            <!-- 任务区 -->
            <Grid Grid.Column="1" x:Name="TaskArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部拖拽条：与侧栏顶条同高，贯穿至悬浮按钮下方 -->
                <Border Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                <!-- 区块标题区：兼作窗口拖拽面 -->
                <Grid Grid.Row="1" Margin="35,18,35,4" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedBlock.Name}" FontSize="22" FontWeight="SemiBold"
                               FontFamily="Helvetica, Segoe UI"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedBlock.TaskCount}" FontSize="13"
                               Foreground="{StaticResource FaintBrush}"
                               Margin="8,0,0,5" VerticalAlignment="Bottom"/>
                </Grid>

                <ListBox x:Name="TaskList" Grid.Row="2"
                         Style="{StaticResource TaskListBox}"
                         ItemsSource="{Binding SelectedBlock.Items}"
                         SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                         ItemTemplateSelector="{StaticResource TaskListTemplateSelector}"
                         VirtualizingStackPanel.IsVirtualizing="False"
                         SelectionMode="Extended"
                         SelectionChanged="TaskList_SelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         behaviors:ScrollBarAutoHide.Enabled="True"
                         Padding="27,2,27,12"
                         PreviewMouseLeftButtonDown="TaskList_PreviewMouseLeftButtonDown"
                         PreviewMouseRightButtonDown="TaskList_PreviewMouseRightButtonDown"/>

                <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Foreground="{StaticResource FaintBrush}" LineHeight="22"
                           Text="这里还没有任务&#x0a;Ctrl + N 或点击下方按钮新建"
                           Visibility="{Binding SelectedBlock.HasTasks, Converter={StaticResource InverseBoolToVis}}"/>

                <!-- 底部工具栏：无选中时显示列表级操作，有选中时切换为任务操作（居中、纯图标） -->
                <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                        Padding="0,3">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                            <Button Style="{StaticResource ToolIconButton}" ToolTip="添加任务（Ctrl+N）"
                                    Command="{Binding NewTaskCommand}"
                                    Visibility="{Binding SelectedBlock.IsActiveList, Converter={StaticResource BoolToVis}}">
                                <Path Data="M4,8 H12 M8,4 V12" Width="16" Height="16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                            <Button x:Name="ClearButton" Style="{StaticResource DangerToolIconButton}" ToolTip="清空"
                                    Click="ClearButton_Click"
                                    IsEnabled="{Binding SelectedBlock.HasTasks}"
                                    Visibility="{Binding SelectedBlock.IsArchiveList, Converter={StaticResource BoolToVis}}">
                                <Path Data="M4,5 H12 M5,5 V12.5 Q5,13 5.5,13 H10.5 Q11,13 11,12.5 V5 M6.5,5 V4 Q6.5,3 7,3 H9 Q9.5,3 9.5,4 V5"
                                      Width="16" Height="16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource ToolIconButton}" ToolTip="完成"
                                    Command="{Binding CompleteSelectionCommand}"
                                    Visibility="{Binding SelectedBlock.IsActiveList, Converter={StaticResource BoolToVis}}">
                                <Path Data="M3,8.5 L6.5,12 L13,4.5" Width="16" Height="16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                            <Button Style="{StaticResource ToolIconButton}" ToolTip="移到 WAIT"
                                    Command="{Binding DeferSelectionCommand}"
                                    Visibility="{Binding SelectedBlock.IsDoing, Converter={StaticResource BoolToVis}}">
                                <Path Data="M3,8 H12.5 M9.5,4.5 L13,8 L9.5,11.5" Width="16" Height="16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                            <Button Style="{StaticResource ToolIconButton}" ToolTip="移到 DOING"
                                    Command="{Binding ActivateSelectionCommand}"
                                    Visibility="{Binding SelectedBlock.IsWaiting, Converter={StaticResource BoolToVis}}">
                                <Path Data="M3,8 H12.5 M9.5,4.5 L13,8 L9.5,11.5" Width="16" Height="16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                            <Button Style="{StaticResource ToolIconButton}" ToolTip="恢复"
                                    Command="{Binding RestoreSelectionCommand}"
                                    Visibility="{Binding SelectedBlock.IsArchiveList, Converter={StaticResource BoolToVis}}">
                                <Path Data="M12.5,8 H3.5 M6.5,4.5 L3,8 L6.5,11.5" Width="16" Height="16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                            <Button Style="{StaticResource ToolIconButton}" ToolTip="废弃"
                                    Command="{Binding DiscardSelectionCommand}"
                                    Visibility="{Binding SelectedBlock.IsDeleted, Converter={StaticResource InverseBoolToVis}}">
                                <Path Data="M4,5 H12 M5,5 V12.5 Q5,13 5.5,13 H10.5 Q11,13 11,12.5 V5 M6.5,5 V4 Q6.5,3 7,3 H9 Q9.5,3 9.5,4 V5"
                                      Width="16" Height="16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                            <Button Style="{StaticResource DangerToolIconButton}" ToolTip="彻底删除"
                                    Command="{Binding DeleteSelectionCommand}"
                                    Visibility="{Binding SelectedBlock.IsDeleted, Converter={StaticResource BoolToVis}}">
                                <Path Data="M4,4 L12,12 M12,4 L4,12" Width="16" Height="16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 无文档遮罩 -->
            <Grid Grid.ColumnSpan="2" Background="{StaticResource CanvasBrush}"
                  Visibility="{Binding HasDocument, Converter={StaticResource InverseBoolToVis}}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Stanza" FontSize="30" FontWeight="SemiBold"
                               FontFamily="Helvetica, Segoe UI" HorizontalAlignment="Center"/>
                    <TextBlock Text="极简的纯文本任务管理" Foreground="{StaticResource FaintBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="将 .stanza 文件拖入窗口，或按 Ctrl + O 打开" FontSize="14"
                               Foreground="{StaticResource GrayBrush}" Margin="0,36,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ctrl + Shift + N 新建文件" FontSize="11"
                               Foreground="{StaticResource FaintBrush}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 悬浮窗控件：状态文本 + 窗口按钮，盖在内容区右上角 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Height="38">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Foreground="{Binding StatusKind, Converter={StaticResource StatusToBrush}}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <!-- 状态被清空时淡出，出现新状态时淡入 -->
                            <DataTrigger Binding="{Binding StatusKind}" Value="None">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Style="{StaticResource WindowButton}" Click="Min_Click" ToolTip="最小化">
                <Path Data="M0,0 H8" Stroke="{StaticResource GrayBrush}" StrokeThickness="1"
                      Width="8" Height="8" Stretch="Uniform"/>
            </Button>
            <Button Style="{StaticResource WindowButton}" Click="Max_Click" ToolTip="最大化 / 还原">
                <Path Data="M0,0 H8 V8 H0 Z" Stroke="{StaticResource GrayBrush}" StrokeThickness="1"
                      Width="8" Height="8" Stretch="Uniform"/>
            </Button>
            <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="关闭">
                <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="1" Width="8" Height="8" Stretch="Uniform"/>
            </Button>
        </StackPanel>

        <!-- 拖拽幽灵层 -->
        <Canvas x:Name="GhostCanvas" IsHitTestVisible="False" Visibility="Hidden">
            <Border x:Name="GhostCard" Background="White" CornerRadius="8" Padding="12,9"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Opacity="0.96">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.22" Color="#FF1C1C1E"/>
                </Border.Effect>
                <ContentPresenter x:Name="GhostContent"/>
            </Border>
        </Canvas>

        <!-- 文件拖入遮罩 -->
        <Border x:Name="DropOverlay" Background="#F6F6FFFF" Opacity="0.97"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="松开以打开文件" FontSize="16" Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
        </Border>
    </Grid>
</Window>
