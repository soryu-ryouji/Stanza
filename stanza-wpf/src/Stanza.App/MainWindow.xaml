<Window x:Class="Stanza.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Stanza.App.ViewModels"
        xmlns:app="clr-namespace:Stanza.App"
        xmlns:behaviors="clr-namespace:Stanza.App.Behaviors"
        Title="Stanza" Width="1020" Height="700" MinWidth="760" MinHeight="520"
        Icon="pack://application:,,,/Assets/icon.png"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        AllowDrop="True"
        DragEnter="Window_DragEnter" DragOver="Window_DragOver"
        DragLeave="Window_DragLeave" Drop="Window_Drop"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Templates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 侧栏项目/标签条目：名称（含 +/# 前缀）+ 任务数 -->
            <DataTemplate x:Key="FacetItemTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NameText" Text="{Binding Name}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="11"
                               Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                        <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                        <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="ShadowHost" Margin="16">
        <!-- 静态阴影源：独立一层且不随内容变化，避免动画时每帧重算整窗模糊 -->
        <Border x:Name="ShadowShape" Background="#FF1C1C1E" CornerRadius="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270" Color="Black" Opacity="0.28"/>
            </Border.Effect>
        </Border>
        <Border x:Name="WindowFrame" Background="{StaticResource CanvasBrush}" SizeChanged="WindowFrame_SizeChanged">
    <Grid x:Name="Root">
        <!-- ============ 内容区（充满整个窗口，悬浮层位于其上） ============ -->
        <Grid x:Name="ContentArea" PreviewMouseLeftButtonDown="ContentArea_PreviewMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧栏 -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 侧栏顶部：文件名（兼窗口拖拽面） -->
                    <Border Grid.Row="0" Background="Transparent"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock Text="{Binding FileName}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource GrayBrush}" Margin="14,0,8,0"
                                   ToolTip="{Binding FilePath}" TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="BlockList" Grid.Row="0"
                                 ItemsSource="{Binding Blocks}"
                                 SelectedItem="{Binding SelectedBlock, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource SidebarItemStyle}"
                                 Margin="0,2,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}"/>
                                    <TextBlock x:Name="NameText" Grid.Column="1" Text="{Binding Name}"
                                               Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TaskCount}" FontSize="11"
                                               Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding IsArchiveList, Converter={StaticResource InverseBoolToVis}}"/> <!-- 归档区块（已完成/回收站）不显示计数（归档统计无行动价值） -->
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                        <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 项目 / 标签：聚合面板入口；分组头可点击收起列表；内容超出时整体滚动 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,8,0,4">
                                <Button Style="{StaticResource GhostButton}" Margin="8,4,8,0" Padding="8,3"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding ToggleFacetSectionCommand}" CommandParameter="projects"
                                        ToolTip="{DynamicResource Tip_ToggleSection}"
                                        Visibility="{Binding HasProjects, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                   Foreground="{StaticResource FaintBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProjectsExpanded}" Value="False">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value><RotateTransform Angle="-90"/></Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{DynamicResource Sidebar_Projects}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FaintBrush}"/>
                                    </StackPanel>
                                </Button>
                                <ListBox x:Name="ProjectList" ItemsSource="{Binding Projects}"
                                         ItemTemplate="{StaticResource FacetItemTemplate}"
                                         ItemContainerStyle="{StaticResource SidebarItemStyle}"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         SelectionChanged="ProjectList_SelectionChanged"
                                         PreviewKeyDown="FacetList_PreviewKeyDown"
                                         IsKeyboardFocusWithinChanged="FacetList_FocusWithinChanged"
                                         Visibility="{Binding ShowProjects, Converter={StaticResource BoolToVis}}"/>
                                <Button Style="{StaticResource GhostButton}" Margin="8,10,8,0" Padding="8,3"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding ToggleFacetSectionCommand}" CommandParameter="tags"
                                        ToolTip="{DynamicResource Tip_ToggleSection}"
                                        Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                   Foreground="{StaticResource FaintBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TagsExpanded}" Value="False">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value><RotateTransform Angle="-90"/></Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{DynamicResource Sidebar_Tags}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FaintBrush}"/>
                                    </StackPanel>
                                </Button>
                                <ListBox x:Name="TagList" ItemsSource="{Binding Tags}"
                                         ItemTemplate="{StaticResource FacetItemTemplate}"
                                         ItemContainerStyle="{StaticResource SidebarItemStyle}"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         SelectionChanged="TagList_SelectionChanged"
                                         PreviewKeyDown="FacetList_PreviewKeyDown"
                                         IsKeyboardFocusWithinChanged="FacetList_FocusWithinChanged"
                                         Visibility="{Binding ShowTags, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ScrollViewer>

                    <!-- 左下角：打开 / 新建 / 最近（左）+ 设置（右）；含快捷键的 tooltip 由代码按当前键位合成 -->
                    <Grid Grid.Row="2" Margin="8,6">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="OpenButton" Style="{StaticResource ToolIconButton}"
                                    Command="{Binding OpenCommand}">
                                <Path Data="M2.5,4 H6.5 L8.5,6.5 H13.5 V12.5 H2.5 Z" Width="16" Height="16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                            <Button x:Name="NewDocButton" Style="{StaticResource ToolIconButton}"
                                    Command="{Binding NewDocumentCommand}">
                                <Path Data="M4.5,2.5 H9.5 L11.5,4.5 V13.5 H4.5 Z M9.5,2.5 V4.5 H11.5 M8,7.5 V10.5 M6.5,9 H9.5"
                                      Width="16" Height="16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                            <Button x:Name="RecentButton" Style="{StaticResource ToolIconButton}" ToolTip="{DynamicResource Tip_RecentFiles}"
                                    Click="RecentButton_Click">
                                <Path Data="M8,2.8 A5.2,5.2 0 1 0 8,13.2 A5.2,5.2 0 1 0 8,2.8 M8,5.2 V8 L10.2,9.2"
                                      Width="16" Height="16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource ToolIconButton}"
                                ToolTip="{DynamicResource Tip_Settings}" Click="SettingsButton_Click">
                            <!-- 设置：Segoe Fluent Icons 齿轮（与右键菜单图标同字体；原自绘齿轮像太阳） -->
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                        </Button>
                    </Grid>
                    </Grid>
                    <Popup x:Name="RecentPopup" PlacementTarget="{Binding ElementName=RecentButton}"
                           Placement="Top" AllowsTransparency="True">
                        <Border x:Name="RecentPanel" Background="White" CornerRadius="8" Padding="4"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                Width="208" Margin="0,0,0,2">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18" Color="#FF1C1C1E"/>
                            </Border.Effect>
                            <StackPanel>
                                <ItemsControl x:Name="RecentItems" ItemsSource="{Binding Recents.Items}">
                                    <!-- 条目容器拉伸到整行宽度，保证每行一致 -->
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="{x:Type ContentPresenter}">
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button x:Name="RowButton" HorizontalContentAlignment="Stretch" Padding="8,5"
                                                    ToolTip="{Binding Path}"
                                                    Command="{Binding DataContext.Recents.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}"
                                                    CommandParameter="{Binding Path}"
                                                    Click="RecentItem_Click">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
                                                        <Style.Triggers>
                                                            <!-- Ctrl+R 键盘循环的高亮：与 hover 同款视觉 -->
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="24"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Button x:Name="RemoveButton" Content="×" FontSize="11"
                                                            Grid.Column="1" VerticalAlignment="Center"
                                                            Style="{StaticResource GhostButton}" Padding="6,1"
                                                            ToolTip="{DynamicResource Tip_RemoveRecent}"
                                                            Command="{Binding DataContext.Recents.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}"
                                                            CommandParameter="{Binding Path}"
                                                            Opacity="0" IsHitTestVisible="False"/>
                                                </Grid>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=RowButton}" Value="True">
                                                    <Setter TargetName="RemoveButton" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="RemoveButton" Property="IsHitTestVisible" Value="True"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{DynamicResource Recent_Empty}" FontSize="11" Padding="8,6"
                                           Foreground="{StaticResource FaintBrush}"
                                           Visibility="{Binding Recents.Items.Count, Converter={StaticResource ZeroToVis}}"/>
                                <!-- 固定在列表底部的新建入口，点击后关闭弹层 -->
                                <Separator/>
                                <Button x:Name="RecentNewButton" Style="{StaticResource GhostButton}" Content="{DynamicResource Tip_NewFile}"
                                        HorizontalContentAlignment="Left" Padding="8,5"
                                        Command="{Binding NewDocumentCommand}"
                                        Click="RecentItem_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="{StaticResource LineBrush}"/>

            <!-- 任务区 -->
            <Grid Grid.Column="1" x:Name="TaskArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部拖拽条：与侧栏顶条同高，贯穿至悬浮按钮下方 -->
                <Border Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                <!-- 区块标题区：兼作窗口拖拽面 -->
                <Grid Grid.Row="1" Margin="35,18,35,4" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ScopeTitle}" FontSize="22" FontWeight="SemiBold"
                               FontFamily="Helvetica, Segoe UI"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding ScopeTaskCount}" FontSize="13"
                               Foreground="{StaticResource FaintBrush}"
                               Margin="8,0,0,5" VerticalAlignment="Bottom"
                               Visibility="{Binding ShowScopeCount, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- 像素滚动：面板视图分组后顶层容器是 GroupItem，逻辑滚动（默认）会把点击任务的
                     整个分段滚动置顶；像素滚动下 BringIntoView 只做最小位移 -->
                <ListBox x:Name="TaskList" Grid.Row="2"
                         Style="{StaticResource TaskListBox}"
                         ItemsSource="{Binding TaskListSource}"
                         SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                         ItemTemplateSelector="{StaticResource TaskListTemplateSelector}"
                         VirtualizingStackPanel.IsVirtualizing="False"
                         ScrollViewer.CanContentScroll="False"
                         SelectionMode="Extended"
                         SelectionChanged="TaskList_SelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         behaviors:ScrollBarAutoHide.Enabled="True"
                         Padding="27,2,27,12"
                         PreviewMouseLeftButtonDown="TaskList_PreviewMouseLeftButtonDown"
                         PreviewMouseRightButtonDown="TaskList_PreviewMouseRightButtonDown">
                    <!-- 面板视图（项目/标签）按状态分段；区块视图无分组描述，不渲染组头。
                         组头与侧栏区块条目使用同一套状态色点，分段间留出间距便于区分 -->
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="9,20,0,4">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                 Fill="{Binding Name, Converter={StaticResource StateToBrush}}"/>
                                        <TextBlock Text="{Binding Name, Converter={StaticResource StateToName}}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource GrayBrush}" Margin="7,0,0,0"/>
                                        <TextBlock Text="{Binding ItemCount}" FontSize="11"
                                                   Foreground="{StaticResource FaintBrush}"
                                                   Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>

                <TextBlock x:Name="EmptyHint" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Foreground="{StaticResource FaintBrush}" LineHeight="22"
                           Visibility="{Binding ScopeHasTasks, Converter={StaticResource InverseBoolToVis}}"/>

                <!-- 底部工具栏：无选中时显示列表级操作，有选中时切换为任务操作（居中、纯图标） -->
                <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                        Padding="0,3">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                            <Button x:Name="AddTaskButton" Style="{StaticResource ToolIconButton}"
                                    Command="{Binding NewTaskCommand}"
                                    Visibility="{Binding ShowAddTask, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            </Button>
                            <Button x:Name="ClearButton" Style="{StaticResource DangerToolIconButton}" ToolTip="{DynamicResource Tip_Clear}"
                                    Click="ClearButton_Click"
                                    IsEnabled="{Binding SelectedBlock.HasTasks}"
                                    Visibility="{Binding ShowClear, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource ToolIconButton}" ToolTip="{DynamicResource Tip_Complete}"
                                    Command="{Binding CompleteSelectionCommand}"
                                    Visibility="{Binding ScopeIsActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            </Button>
                            <Button Style="{StaticResource ToolIconButton}" ToolTip="{DynamicResource Tip_Defer}"
                                    Command="{Binding DeferSelectionCommand}"
                                    Visibility="{Binding ScopeIsDoing, Converter={StaticResource BoolToVis}}">
                                <!-- 暂停符：等待/挂起 -->
                                <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            </Button>
                            <Button Style="{StaticResource ToolIconButton}" ToolTip="{DynamicResource Tip_Activate}"
                                    Command="{Binding ActivateSelectionCommand}"
                                    Visibility="{Binding ScopeIsWaiting, Converter={StaticResource BoolToVis}}">
                                <!-- 播放符：开始执行 -->
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            </Button>
                            <Button Style="{StaticResource ToolIconButton}" ToolTip="{DynamicResource Tip_Restore}"
                                    Command="{Binding RestoreSelectionCommand}"
                                    Visibility="{Binding ScopeIsArchive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            </Button>
                            <Button Style="{StaticResource ToolIconButton}" ToolTip="{DynamicResource Tip_Discard}"
                                    Command="{Binding DiscardSelectionCommand}"
                                    Visibility="{Binding ScopeIsDeleted, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            </Button>
                            <Button Style="{StaticResource DangerToolIconButton}" ToolTip="{DynamicResource Tip_Delete}"
                                    Command="{Binding DeleteSelectionCommand}"
                                    Visibility="{Binding ScopeIsDeleted, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 无文档遮罩 -->
            <Grid Grid.ColumnSpan="2" Background="{StaticResource CanvasBrush}"
                  Visibility="{Binding HasDocument, Converter={StaticResource InverseBoolToVis}}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Stanza" FontSize="30" FontWeight="SemiBold"
                               FontFamily="Helvetica, Segoe UI" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Welcome_Tagline}" Foreground="{StaticResource FaintBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock x:Name="WelcomeOpenHint" FontSize="14"
                               Foreground="{StaticResource GrayBrush}" Margin="0,36,0,0" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="WelcomeNewHint" FontSize="11"
                               Foreground="{StaticResource FaintBrush}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 悬浮窗控件：状态文本 + 窗口按钮，盖在内容区右上角 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Height="38">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Foreground="{Binding StatusKind, Converter={StaticResource StatusToBrush}}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <!-- 状态被清空时淡出，出现新状态时淡入 -->
                            <DataTrigger Binding="{Binding StatusKind}" Value="None">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Style="{StaticResource WindowButton}" Click="Min_Click" ToolTip="{DynamicResource Tip_Minimize}">
                <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="9"
                           Foreground="{StaticResource GrayBrush}"/>
            </Button>
            <Button Style="{StaticResource WindowButton}" Click="Max_Click" ToolTip="{DynamicResource Tip_Maximize}">
                <TextBlock Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="9"
                           Foreground="{StaticResource GrayBrush}"/>
            </Button>
            <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="{DynamicResource Tip_CloseWindow}">
                <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="9"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            </Button>
        </StackPanel>

        <!-- 拖拽幽灵层 -->
        <Canvas x:Name="GhostCanvas" IsHitTestVisible="False" Visibility="Hidden">
            <Border x:Name="GhostCard" Background="White" CornerRadius="8" Padding="12,9"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Opacity="0.96">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.22" Color="#FF1C1C1E"/>
                </Border.Effect>
                <ContentPresenter x:Name="GhostContent"/>
            </Border>
        </Canvas>

        <!-- 文件拖入遮罩 -->
        <Border x:Name="DropOverlay" Background="#F6F6FFFF" Opacity="0.97"
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="{DynamicResource Drop_Hint}" FontSize="16" Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- 设置：语言 + 快捷键。与退出遮罩同款应用内浮层：模态收编键盘、Esc/点空白关闭；
             快捷键行由代码构建（MainWindow.Settings.cs），录制中的按键被吃掉不穿透。
             位于退出遮罩之前：关窗确认层始终在最上 -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed"
              KeyboardNavigation.TabNavigation="Cycle"
              PreviewKeyDown="Settings_KeyDown">
            <Border Background="#401C1C1E" PreviewMouseLeftButtonDown="Settings_DimMouseDown"/>
            <Border x:Name="SettingsCard" Width="440" Padding="24,20,24,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" CornerRadius="12"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Color="#FF1C1C1E"/>
                </Border.Effect>
                <Border.Resources>
                    <!-- 语言选项：chip 式单选 -->
                    <Style x:Key="LangChip" TargetType="{x:Type RadioButton}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type RadioButton}">
                                    <Border x:Name="Chip" Padding="12,3" CornerRadius="11"
                                            BorderThickness="1" BorderBrush="{StaticResource LineBrush}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Title}" FontSize="15" FontWeight="SemiBold"/>

                        <TextBlock Text="{DynamicResource Settings_Language}" FontSize="11" Margin="0,16,0,6"
                                   Foreground="{StaticResource FaintBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LangZh" Content="中文" Style="{StaticResource LangChip}"
                                         Margin="0,0,8,0" Checked="Lang_Checked"/>
                            <RadioButton x:Name="LangEn" Content="English" Style="{StaticResource LangChip}"
                                         Checked="Lang_Checked"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Settings_KeyboardMode}" FontSize="11" Margin="0,14,0,6"
                                   Foreground="{StaticResource FaintBrush}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeWindows" Content="Windows" Style="{StaticResource LangChip}"
                                         Margin="0,0,8,0" Checked="KbdMode_Checked"/>
                            <RadioButton x:Name="ModeMac" Content="macOS" Style="{StaticResource LangChip}"
                                         Checked="KbdMode_Checked"/>
                        </StackPanel>

                        <Grid Margin="0,18,0,4">
                            <TextBlock Text="{DynamicResource Settings_Shortcuts}" FontSize="11"
                                       Foreground="{StaticResource FaintBrush}"/>
                            <!-- 录制/错误提示：与「快捷键」标题同行右缘 -->
                            <TextBlock x:Name="RecordingHint" HorizontalAlignment="Right" FontSize="11"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel x:Name="KeymapRows"/>

                        <!-- 键位冲突确认条 -->
                        <Border x:Name="ConflictBar" Visibility="Collapsed" Margin="0,12,0,0"
                                Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="10,7">
                            <StackPanel>
                                <TextBlock x:Name="ConflictText" FontSize="11.5" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Exit_Cancel}"
                                            FontSize="11.5" Padding="8,2" Click="ConflictCancel_Click"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Settings_Reassign}"
                                            FontSize="11.5" Padding="10,2" Margin="8,0,0,0" Click="ConflictConfirm_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 退出确认遮罩：未保存更改时关闭窗口的应用内确认层（代替原生 MessageBox） -->
        <Grid x:Name="ExitOverlay" Visibility="Collapsed" Opacity="0"
              KeyboardNavigation.TabNavigation="Cycle"
              PreviewKeyDown="ExitOverlay_KeyDown">
            <!-- 暗化背景：点击空白 = 取消 -->
            <Border Background="#401C1C1E" PreviewMouseLeftButtonDown="ExitOverlay_DimMouseDown"/>
            <Border x:Name="ExitCard" Width="380" Padding="26,22,26,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" CornerRadius="12"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" Color="#FF1C1C1E"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ExitCardScale" ScaleX="0.96" ScaleY="0.96"/>
                </Border.RenderTransform>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Exit_Title}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ExitHintText" Margin="0,7,0,0" FontSize="12.5" Foreground="{StaticResource GrayBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Exit_Cancel}" MinWidth="56"
                                Click="ExitCancel_Click"/>
                        <Button Style="{StaticResource DialogDangerButton}" Content="{DynamicResource Exit_Discard}" MinWidth="56"
                                Margin="8,0,0,0" Click="ExitDiscard_Click"/>
                        <Button x:Name="ExitSaveButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Exit_Save}"
                                MinWidth="64" Margin="12,0,0,0" Click="ExitSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <!-- 选择器浮层：标签/项目（FacetPickerPanel）与通用选择面板（ChoicePickerPanel，状态/优先级）
             两个面板共用，任一可见即显示（代码维护）。右键菜单或快捷键（T/P/M/Shift+P）在鼠标/选中任务旁展开；
             与窗口同一视觉树（不用独立 Popup，规避跨 HWND 的焦点/失活时序问题）；
             点面板以外区域关闭。焦点在浮层内时主界面的任务作用域快捷键不接管（作用域检查） -->
        <Canvas x:Name="PickerLayer" Visibility="Collapsed" Background="Transparent"
                PreviewMouseLeftButtonDown="PickerLayer_PreviewMouseDown">
            <Border x:Name="FacetPickerPanel" Width="200" Padding="5" Visibility="Collapsed"
                    Background="{StaticResource DarkPanelBrush}"
                    CornerRadius="8"
                    BorderBrush="{StaticResource DarkPanelBorderBrush}" BorderThickness="1"
                    SnapsToDevicePixels="True"
                    PreviewKeyDown="FacetPicker_KeyDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18" Color="#FF1C1C1E"/>
                </Border.Effect>
                <StackPanel>
                    <TextBox x:Name="FacetPickerInput" FontSize="12" Margin="2,0" TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             Foreground="{StaticResource OnDarkTextBrush}"
                             TextChanged="FacetPickerInput_TextChanged"/>
                    <TextBlock x:Name="FacetPickerError" FontSize="11" Margin="6,2,6,0" Visibility="Collapsed"
                               Foreground="{StaticResource DangerBrush}"/>
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FacetPickerList" Margin="0,2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PickerRowButton}"
                                            HorizontalContentAlignment="Stretch"
                                            Tag="{Binding Highlighted}"
                                            MouseEnter="FacetPickerRow_MouseEnter"
                                            Click="FacetPickerRow_Click">
                                        <Grid>
                                            <TextBlock Text="{Binding Display}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Visibility="{Binding Applied, Converter={StaticResource BoolToVis}}">
                                                <!-- 高亮行（悬停/键盘高亮 Tag=true）底色同为强调蓝，勾随文字转白，避免融入背景 -->
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button x:Name="FacetPickerClear" Style="{StaticResource PickerRowButton}"
                            Background="{StaticResource DarkPanelRaisedBrush}"
                            HorizontalContentAlignment="Center" Margin="0,2,0,0"
                            MouseEnter="FacetPickerClear_MouseEnter"
                            Click="FacetPickerClear_Click">
                        <!-- 显式 TextBlock：字符串内容自动生成的 TextBlock 会被隐式样式的墨色
                             盖住按钮前景色，必须显式绑定 -->
                        <TextBlock Text="{DynamicResource Picker_Clear}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                    </Button>
                </StackPanel>
            </Border>
            <!-- 通用选择面板：状态（M / 右键「状态…」）与优先级（Shift+P）共用。
                 行由代码在打开时按描述符构建（本地化与当前值标记始终新鲜）；
                 面板内加速键直达、方向键/jk + Enter 确认、Esc 或再按激活键关闭 -->
            <Border x:Name="ChoicePickerPanel" Width="200" Padding="5" Visibility="Collapsed"
                    Background="{StaticResource DarkPanelBrush}"
                    CornerRadius="8"
                    BorderBrush="{StaticResource DarkPanelBorderBrush}" BorderThickness="1"
                    SnapsToDevicePixels="True" Focusable="True"
                    InputMethod.IsInputMethodEnabled="False"
                    PreviewKeyDown="ChoicePicker_KeyDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18" Color="#FF1C1C1E"/>
                </Border.Effect>
                <StackPanel x:Name="ChoicePickerRows"/>
            </Border>
        </Canvas>
    </Grid>
        </Border>
    </Grid>
</Window>
